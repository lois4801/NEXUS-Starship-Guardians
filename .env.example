# Nexus Starship Guardians environment template
# Generate a strong token with: python -c "import secrets; print(secrets.token_urlsafe(40))"
NEXUS_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Local development persistence
NEXUS_DB_PATH=./data/nexus.db
NEXUS_LEARNING_PATH=./data/guardian_learning.jsonl
NEXUS_EVALUATION_PATH=./data/guardian_evaluations.jsonl
NEXUS_ADAPTIVE_INTELLIGENCE_PATH=./data/adaptive_guardian_intelligence.json

# Default runnable model endpoint. Local Ollama/OpenAI-compatible endpoints may use HTTP only on localhost.
NEXUS_MODEL_BASE_URL=http://localhost:11434/v1
NEXUS_MODEL_NAME=llama3.2
NEXUS_MODEL_API_KEY=

# Optional production/distributed PostgreSQL integration.
# Used by integration tests and future distributed worker wiring, not required for the SQLite starter runtime.
NEXUS_POSTGRES_DSN=postgresql://nexus:CHANGE_ME@127.0.0.1:5432/nexus

# Only for LOCAL testing on a trusted machine; never expose dev mode publicly.
NEXUS_DEV_MODE=false
